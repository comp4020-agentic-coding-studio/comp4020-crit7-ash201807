---
import { db } from "../lib/db";
import { getSelectedSessions, getTimetableConflicts } from "../lib/planner";
import { formatDayOfWeek, formatSessionTime } from "../lib/session-labels";
import "../styles.css";

const selected = getSelectedSessions(db);
const conflicts = getTimetableConflicts(db);
const conflictingPlannedCourseIds = new Set(conflicts.flatMap((c) => [c.a.plannedCourseId, c.b.plannedCourseId]));

const plannerStatus = Astro.url.searchParams.get("plannerStatus");
const plannerMessage = Astro.url.searchParams.get("plannerMessage");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Timetable — MCOMP Planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">MCOMP Planner</a>
      <a href="/requirements/">Requirements</a>
      <a href="/requirements/#my-plan-heading">My Plan</a>
      <a href="/timetable/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Timetable</h1>

      {
        plannerMessage && (
          <p class={`banner banner--${plannerStatus === "error" ? "error" : "success"}`}>{plannerMessage}</p>
        )
      }

      {
        conflicts.length > 0 && (
          <p class="banner banner--error">
            {conflicts.length} timetable {conflicts.length === 1 ? "conflict" : "conflicts"} found.
          </p>
        )
      }

      {
        selected.length === 0 && (
          <p>
            No sessions selected yet. Choose a session from your <a href="/requirements/#my-plan-heading">My Plan</a> list.
          </p>
        )
      }

      {
        selected.length > 0 && (
          <table>
            <thead>
              <tr>
                <th scope="col">Course</th>
                <th scope="col">Session</th>
                <th scope="col">Day &amp; time</th>
                <th scope="col">Location</th>
                <th scope="col">
                  <span class="visually-hidden">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {selected.map((s) => (
                <tr class={conflictingPlannedCourseIds.has(s.plannedCourseId) ? "conflict" : undefined}>
                  <td>{s.courseCode}</td>
                  <td>{s.session.sessionCode}</td>
                  <td>{formatSessionTime(s.session)}</td>
                  <td>{s.session.location}</td>
                  <td>
                    <a href={`/timetable/${s.plannedCourseId}`}>Change session</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }

      {
        conflicts.length > 0 && (
          <>
            <h2>Conflicts</h2>
            <ul>
              {conflicts.map((c) => (
                <li>
                  {c.a.courseCode} ({c.a.sessionCode}) overlaps {c.b.courseCode} ({c.b.sessionCode}) on{" "}
                  {formatDayOfWeek(c.dayOfWeek)}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </main>
  </body>
</html>
